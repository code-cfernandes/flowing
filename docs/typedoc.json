      "theme_index": "Índice",
      "theme_type_declaration": "Declaração do tipo",
      "theme_hierarchy": "Hierarquia",
      "kind_call_signature": "Assinatura",
      "kind_get_signature": "Assinatura do getter",
      "kind_set_signature": "Assinatura do setter",
      "kind_index_signature": "Assinatura de índice",
      "kind_class": "Classe",
