      "kind_module": "Módulo",
      "kind_plural_class": "Classes",
      "kind_plural_interface": "Interfaces",
      "kind_plural_function": "Funções",
      "kind_plural_type_alias": "Tipos",
      "kind_plural_variable": "Variáveis",
