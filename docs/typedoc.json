{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["../src/index.ts"],
  "tsconfig": "../tsconfig.build.json",
  "out": "referencia/api",
  "docsRoot": ".",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "excludeInternal": true,
  "excludePrivate": true,
  "readme": "none",
  "hidePageHeader": true,
  "githubPages": false,
  "sourceLinkTemplate": "https://github.com/code-cfernandes/flowing/blob/main/{path}#L{line}",
  "gitRevision": "main",
  "lang": "pt",
  "locales": {
    "pt": {
      "theme_defined_in": "Definido em",
      "theme_returns": "Retorna",
