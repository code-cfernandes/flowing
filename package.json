{
  "name": "picodecor",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch examples/app-users/server.ts",
    "example:users": "tsx examples/app-users/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=10000 --test-reporter=spec 'test/**/*.test.ts'",
    "test:watch": "node --import tsx --test --test-timeout=10000 --watch 'test/**/*.test.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^26.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-json-stringify": "^7.2.1",
    "find-my-way": "^9.10.0"
  }
}
