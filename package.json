{
  "name": "flowingts",
  "version": "0.19.0",
  "description": "Micro-framework HTTP para Node.js com decorators TC39 nativos, schema-first (TypeBox + Ajv) e defaults seguros.",
  "keywords": [
    "http",
    "framework",
    "decorators",
    "tc39",
    "typescript",
    "typebox",
    "ajv",
    "schema",
    "api",
    "rest"
  ],
  "author": "Caio Fernandes",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-cfernandes/flowing.git"
  },
  "homepage": "https://github.com/code-cfernandes/flowing#readme",
  "bugs": {
    "url": "https://github.com/code-cfernandes/flowing/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/core/index.js",
    "./dist/core/app.js",
    "./dist/shims/*.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch examples/app-users/server.ts",
    "example:users": "tsx examples/app-users/server.ts",
    "test:examples": "node --import tsx --test --test-timeout=20000 --test-reporter=spec 'examples/*/app.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "node --import tsx --test --test-timeout=10000 --test-reporter=spec 'test/**/*.test.ts'",
    "test:watch": "node --import tsx --test --test-timeout=10000 --watch 'test/**/*.test.ts'",
    "test:coverage": "node --import tsx --test --test-timeout=10000 --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=90 'test/**/*.test.ts'",
    "prepublishOnly": "pnpm check && pnpm typecheck && pnpm test:coverage && pnpm build",
    "clean": "rm -rf dist"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26.0.0",
    "@types/qs": "^6.15.1",
    "qs": "^6.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.5",
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-json-stringify": "^7.2.1",
    "find-my-way": "^9.10.0",
    "magic-bytes.js": "^1.13.1"
  }
}
